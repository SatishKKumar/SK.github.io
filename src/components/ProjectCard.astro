---
const { title, description, link } = Astro.props;
---

<div class="p-6 bg-white/5 backdrop-blur-md rounded-xl hover:scale-105 transition-transform">
  <h3 class="text-xl font-bold mb-2">{title}</h3>
  <p class="text-sm">{description}</p>
  {link && <a href={link} class="text-blue-400 mt-2 block">Learn More →</a>}
</div>