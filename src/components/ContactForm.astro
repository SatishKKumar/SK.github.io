<form action="https://formspree.io/f/<your-id>" method="POST" class="flex flex-col gap-4">
  <input type="text" name="name" placeholder="Your Name" class="p-3 rounded-lg bg-white/10" required />
  <input type="email" name="email" placeholder="Your Email" class="p-3 rounded-lg bg-white/10" required />
  <textarea name="message" rows="4" placeholder="Your Message" class="p-3 rounded-lg bg-white/10" required></textarea>
  <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white p-3 rounded-lg font-bold">Send Message</button>
</form>