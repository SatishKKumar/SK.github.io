---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Satish K | Freelance Data Scientist</title>
  </head>
  <body class="bg-gradient-to-r from-blue-900 via-blue-800 to-gray-900 text-white font-sans">
    <Header />

    <main class="px-6 md:px-12 space-y-20">
      <!-- About Section -->
      <section class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-10">
        <div class="flex-1">
          <h1 class="text-5xl md:text-6xl font-bold">Hi, I'm <span class="text-blue-400">Satish</span></h1>
          <p class="mt-4 text-lg md:text-xl">Freelance Data Scientist specializing in ML, Time Series, and NLP.</p>
          <a href="mailto:satish9901744@gmail.com" class="mt-6 inline-block px-6 py-3 bg-blue-400 text-black font-bold rounded-lg hover:scale-105 transition-transform">Send Me a Message</a>
        </div>
        <div class="flex-1">
          <!-- Placeholder for image or illustration -->
          <img src="/images/profile.png" alt="Satish K" class="rounded-xl shadow-2xl" />
        </div>
      </section>

      <!-- Projects Section -->
      <section class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 hover:-translate-y-2 transform transition">
          <h3 class="text-xl font-bold">Battery Failure Prediction</h3>
          <p class="mt-2 text-gray-200">ML + rule-based system predicting battery failures 30 days in advance.</p>
        </div>
        <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 hover:-translate-y-2 transform transition">
          <h3 class="text-xl font-bold">Media Mix Modeling</h3>
          <p class="mt-2 text-gray-200">Optimized marketing ROI using regression and time series forecasting techniques.</p>
        </div>
        <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 hover:-translate-y-2 transform transition">
          <h3 class="text-xl font-bold">NLP Product Mapping</h3>
          <p class="mt-2 text-gray-200">Used BERT to map product hierarchy across multiple datasets with high accuracy.</p>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>